{
    "manifest_version": 3,
    "name": "Web Page Summarizer with OpenAI or Claude AI",
    "version": "1.2",
    "description": "Summarizes the content of the current webpage using Claude AI",
    "permissions": ["activeTab", "sidePanel", "scripting"],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Webpage Summarizer"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }